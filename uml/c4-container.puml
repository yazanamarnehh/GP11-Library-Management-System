@startuml c4-container
!include <C4/C4_Container>

LAYOUT_WITH_LEGEND()

title Container Diagram (C4 Level 2) — GP11 Library Management System

Person(guest, "Guest", "Unauthenticated catalog visitor.")
Person(member, "Member", "Registered library patron.")
Person(librarian, "Librarian", "Circulation and catalog staff.")
Person(admin, "Administrator", "Staff and policy administrator.")

System_Boundary(lms_boundary, "Library Management System") {
    Container(webapp, "Spring Boot Web Application", "Java 21, Spring Boot 4.1, Thymeleaf, Spring Security", "Renders the server-side Thymeleaf UI (NFR-08), enforces role-based authorization (NFR-01), executes layered business logic (NFR-06), runs the internal daily Scheduler (FR-18, FR-24, FR-31) and the simulated Notification Adapter.")
    ContainerDb(db, "PostgreSQL Database", "PostgreSQL 16 + Flyway", "Stores titles, copies, members, accounts, loans, reservations, fines, payments, audit trails, and simulated notifications (NFR-03, NFR-04, NFR-09).")
}

System_Ext(email, "Email Service (Simulated)", "Logical external notification channel; implemented locally by persisting notification records in PostgreSQL.")

Rel(guest, webapp, "Browses and searches catalog", "Web browser, HTTPS")
Rel(member, webapp, "Manages loans, reservations, fines, and profile", "Web browser, HTTPS")
Rel(librarian, webapp, "Runs catalog, member, circulation, fine, and report workflows", "Web browser, HTTPS")
Rel(admin, webapp, "Manages staff accounts and lending policy", "Web browser, HTTPS")

Rel(webapp, db, "Reads and writes domain data in transactions; applies Flyway migrations", "JDBC / Spring Data JPA (NFR-03, NFR-04)")
Rel(webapp, email, "Notification Adapter writes simulated email notices to DB", "Simulated / DB Write (FR-23, FR-31)")

@enduml
